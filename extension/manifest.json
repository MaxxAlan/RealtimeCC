{
  "manifest_version": 3,
  "name": "RealtimeCC Browser Bridge",
  "version": "1.0.0",
  "description": "Bridges HTML5 video playback position and state to RealtimeCC for zero-delay pre-rolled subtitles.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RealtimeCC Extension Settings"
  }
}
